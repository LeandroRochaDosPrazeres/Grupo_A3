# ============================================
# Finance Team - Exemplo de variaveis de ambiente
# ============================================
# Copie este arquivo para ".env" (na raiz do projeto E em src/view/)
# e preencha com as credenciais reais do seu projeto Supabase.
#
# NUNCA versione o arquivo .env real (ele esta no .gitignore).

# URL base da API REST do Supabase
# Encontrada em: Supabase > Project Settings > API > Project URL
# Formato: https://<id-do-projeto>.supabase.co/rest/v1
SUPABASE_URL=https://SEU-PROJETO.supabase.co/rest/v1

# Chave de API publica (anon public)
# Encontrada em: Supabase > Project Settings > API > Project API keys > anon public
SUPABASE_API_KEY=SUA_CHAVE_ANON_PUBLIC_AQUI
